{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullImage",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:__REGION__:__ACCOUNT_ID__:repository/bedrock-agentcore-__AGENT__"
    },
    {
      "Sid": "EcrToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "RuntimeLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:DescribeLogStreams", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/bedrock-agentcore/runtimes/*",
        "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*"
      ]
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:*"
    },
    {
      "Sid": "Tracing",
      "Effect": "Allow",
      "Action": ["xray:PutTraceSegments", "xray:PutTelemetryRecords", "xray:GetSamplingRules", "xray:GetSamplingTargets"],
      "Resource": "*"
    },
    {
      "Sid": "Metrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "bedrock-agentcore" } }
    },
    {
      "Sid": "WorkloadIdentity",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetWorkloadAccessToken",
        "bedrock-agentcore:GetWorkloadAccessTokenForJWT",
        "bedrock-agentcore:GetWorkloadAccessTokenForUserId"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:__REGION__:__ACCOUNT_ID__:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:__REGION__:__ACCOUNT_ID__:workload-identity-directory/default/workload-identity/__AGENT__-*"
      ]
    },
    {
      "Sid": "InvokeModel",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-*",
        "arn:aws:bedrock:__REGION__:__ACCOUNT_ID__:inference-profile/*"
      ]
    },
    {
      "Sid": "ReadFinding",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/__FINDINGS_TABLE__"
    },
    {
      "Sid": "WriteDecisionLog",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention"],
      "Resource": "arn:aws:s3:::__DECISION_LOG_BUCKET__/decisions/*"
    },
    {
      "Sid": "PublishDecision",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "__FINDINGS_TOPIC_ARN__"
    },
    {
      "Sid": "ContextToolsGovernanceAccount",
      "Effect": "Allow",
      "Action": [
        "tag:GetResources",
        "cloudtrail:LookupEvents",
        "ce:GetCostAndUsage",
        "ce:GetReservationUtilization"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadMemberAccounts",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/__MEMBER_ROLE_NAME__"
    }
  ]
}
