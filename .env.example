# Local runs only (python -m agents..., pipeline/triage.py, scripts/). The deployed runtime and
# Lambdas get these values from the deploy scripts, not from this file.
AWS_REGION=us-east-1
# Use either a profile or explicit keys
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Must be a model you have enabled in Bedrock > Model access.
# Check the Bedrock console for the exact ID / inference profile available in your region.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0 #us.anthropic.claude-sonnet-4-20250514-v1:0

# ---- printed by deploy/deploy_judgement_foundation.ps1 (replace <account> / <region>) ----
FINDINGS_TABLE=Findings
DECISION_LOG_BUCKET=nura-decisionlog-<account>-<region>
FINDINGS_TOPIC_ARN=arn:aws:sns:<region>:<account>:nura-findings
High_Critical_Queue_Url=https://sqs.<region>.amazonaws.com/<account>/nura-high-critical
# Testing: 1-day GOVERNANCE lock. Production: 2555 (~7 years); COMPLIANCE cannot be removed by
# anyone, including root, before it expires - never test with COMPLIANCE.
DECISION_LOG_RETENTION_DAYS=1
DECISION_LOG_LOCK_MODE=GOVERNANCE

# Member-account reader role; empty = use your own credentials (single-account testing)
MEMBER_ROLE_NAME=
